# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=myapp_db

# JWT — replace with a long random string before going live.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Used by `npm run seed` to create the admin account.
ADMIN_EMAIL=admin@nesrent.ac.id
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin NesRent
ADMIN_NIM=2404130000
